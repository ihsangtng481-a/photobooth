{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile data including preferences and basic info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Photo": {
      "title": "Photo Capture",
      "description": "Metadata for a captured photo or photo strip.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["single", "strip"] },
        "filter": { "type": "string" },
        "frame": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "imageUrl", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/photos/{photoId}": {
      "schema": "Photo",
      "description": "Captured photo metadata."
    }
  }
}
